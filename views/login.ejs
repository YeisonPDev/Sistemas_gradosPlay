<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Iniciar sesión | Control de Grados</title>
  <meta name="description" content="Acceso del personal al registro de asistencia de acudientes a la ceremonia de grados." />
  <meta name="theme-color" content="#0f1b33" />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/webp" href="/img/cursos-logo.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <link rel="preload" as="image" href="/img/login-foto.webp" />
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body class="login-page">
  <div class="login-layout">
    <!-- Panel con foto -->
    <aside class="login-brand">
      <img class="login-photo" src="/img/login-foto.webp" width="2560" height="1470"
        alt="Niños acostados en el pasto formando un círculo, sonriendo y mirando a través de sus manos"
        decoding="async" fetchpriority="high" />

      <div class="login-brand-header" data-enter>
        <img src="/img/cursos-logo.jpg" alt="" class="logo" />
        <strong>Control de Grados</strong>
      </div>

      <div class="login-brand-body" data-enter>
        <h1>Asistencia de acudientes a la ceremonia de grados</h1>
        <p>Cada estudiante tiene hasta dos acudientes. Márcalos al llegar y todas las entradas lo ven al instante.</p>
      </div>
    </aside>

    <!-- Formulario -->
    <main class="login-main">
      <div class="login-card" data-enter>
        <h2>Inicia sesión</h2>
        <p class="login-card-subtitle">Usa el usuario que te asignó el administrador.</p>

        <% if (error) { %>
          <div class="alert alert-error" role="alert" id="loginError">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/login" method="POST" class="login-form" id="loginForm">
          <div class="form-group">
            <label for="user" class="form-label">Usuario</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <input type="text" id="user" name="user" class="form-input" required autocomplete="username"
                autocapitalize="none" spellcheck="false" value="<%= user || '' %>"
                <% if (error) { %>aria-invalid="true" aria-describedby="loginError"<% } %>
                <% if (!user) { %>autofocus<% } %> />
            </div>
          </div>

          <div class="form-group">
            <label for="password" class="form-label">Contraseña</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <input type="password" id="password" name="contraseña" class="form-input has-toggle" required
                autocomplete="current-password" aria-describedby="capsWarning"
                <% if (error) { %>aria-invalid="true"<% } %>
                <% if (user) { %>autofocus<% } %> />
              <button type="button" class="toggle-password" id="togglePassword" aria-label="Mostrar contraseña"
                aria-pressed="false">
                <svg class="icon-eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg class="icon-eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                  <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                  <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                  <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
              </button>
            </div>
            <p class="field-hint" id="capsWarning" aria-live="polite"></p>
          </div>

          <button type="submit" class="btn btn-primary btn-login" id="loginSubmit">
            <span class="btn-spinner" aria-hidden="true"></span>
            <span class="btn-label">Entrar al panel</span>
          </button>
        </form>

        <p class="login-help">¿Olvidaste tu contraseña? Pídele al administrador que la restablezca.</p>
      </div>

      <footer class="login-footer">
        <span>&copy; <%= new Date().getFullYear() %> Control de Grados · Desarrollado por Yeison</span>
      </footer>
    </main>
  </div>

  <script src="/js/login.js"></script>
</body>

</html>
