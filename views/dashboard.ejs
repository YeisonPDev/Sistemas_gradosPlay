<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de asistencia | Control de Grados</title>
    <link rel="icon" type="image/jpeg" href="/img/cursos-logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
</head>

<body data-supabase-url="<%= supabaseUrl %>" data-supabase-key="<%= supabaseAnonKey %>" data-canal="<%= canal %>">
    <!-- BARRA SUPERIOR -->
    <header class="topbar">
        <a href="/dashboard" class="topbar-brand">
            <img src="/img/cursos-logo.jpg" alt="Logo" class="logo" />
            <span class="topbar-title">
                <strong>Control de Grados</strong>
                <span>Sistema de asistencia</span>
            </span>
        </a>

        <div class="topbar-user">
            <div class="user-chip">
                <span class="user-avatar" aria-hidden="true"><%= (user.nombre || "?").charAt(0) %></span>
                <span class="user-name"><%= user.nombre %></span>
            </div>
            <a href="/logout" class="btn btn-ghost-light">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Salir</span>
            </a>
        </div>
    </header>

    <main class="dashboard">
        <!-- ENCABEZADO -->
        <div class="page-header">
            <div>
                <h1>Asistencia de acudientes</h1>
                <p>Bienvenido, <%= user.nombre %>. Marca la llegada de cada acudiente a la ceremonia.</p>
            </div>
            <span class="live-indicator" id="liveIndicator">
                <span class="live-dot"></span>
                <span id="liveText">Conectando...</span>
            </span>
        </div>

        <!-- HERRAMIENTAS -->
        <div class="toolbar">
            <div class="search-wrapper">
                <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <label for="busqueda" class="sr-only">Buscar estudiante</label>
                <input type="search" id="busqueda" placeholder="Buscar por estudiante, acudiente o código"
                    autocomplete="off" />
                <button type="button" class="btn-clear" id="btnClear" aria-label="Limpiar búsqueda" hidden>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <button type="button" class="btn btn-toggle-stats" id="btnToggleStats" aria-expanded="false"
                aria-controls="statsContainer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="20" x2="12" y2="10"></line>
                    <line x1="18" y1="20" x2="18" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="16"></line>
                </svg>
                <span>Ver estadísticas</span>
                <svg class="icon-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>
        </div>

        <!-- ESTADÍSTICAS (ocultas por defecto) -->
        <section class="stats-grid" id="statsContainer" aria-label="Estadísticas de asistencia" hidden>
            <button type="button" class="stat-card stat-success" data-filter="ambos">
                <span class="stat-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </span>
                <span>
                    <span class="stat-value" id="countAmbos">0</span>
                    <span class="stat-label">Ambos asistieron</span>
                </span>
            </button>

            <button type="button" class="stat-card stat-partial" data-filter="uno">
                <span class="stat-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </span>
                <span>
                    <span class="stat-value" id="countUno">0</span>
                    <span class="stat-label">Solo uno asistió</span>
                </span>
            </button>

            <button type="button" class="stat-card stat-danger" data-filter="ninguno">
                <span class="stat-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </span>
                <span>
                    <span class="stat-value" id="countNinguno">0</span>
                    <span class="stat-label">Ninguno asistió</span>
                </span>
            </button>

            <button type="button" class="stat-card stat-total" data-filter="todos">
                <span class="stat-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </span>
                <span>
                    <span class="stat-value" id="countTotal">0</span>
                    <span class="stat-label">Total estudiantes</span>
                </span>
            </button>
        </section>

        <!-- TABLA -->
        <section class="table-card">
            <div class="table-card-header">
                <span id="resultCount"><%= grados.length %> estudiantes</span>
                <div class="legend" aria-hidden="true">
                    <span class="legend-item"><span class="legend-swatch ambos"></span>Ambos</span>
                    <span class="legend-item"><span class="legend-swatch uno"></span>Uno</span>
                    <span class="legend-item"><span class="legend-swatch ninguno"></span>Ninguno</span>
                </div>
            </div>

            <table id="tablaGrados">
                <thead>
                    <tr>
                        <th scope="col">Estudiante</th>
                        <th scope="col">Acudientes y asistencia</th>
                    </tr>
                </thead>
                <tbody>
                    <% grados.forEach(g => { %>
                        <tr data-id="<%= g.id %>"
                            class="<%= (g.estado1 && g.estado2) ? 'fila-ambos-asistieron' : (g.estado1 || g.estado2) ? 'fila-uno-asistio' : 'fila-ninguno-asistio' %>">
                            <td>
                                <span class="student-name"><%= g.Estudiante %></span>
                                <span class="student-code">Código <%= g.Codigo %></span>
                            </td>
                            <td>
                                <div class="acudientes-container">
                                    <% [1, 2].forEach(n => { const estado = g['estado' + n]; %>
                                        <label class="acudiente-item">
                                            <span class="acudiente-info">
                                                <span class="acudiente-label">Acudiente <%= n %></span>
                                                <span class="acudiente-name <%= estado ? 'estado-verde' : 'estado-rojo' %>"
                                                    data-name="<%= n %>"><%= g['Acudiente_' + n] %></span>
                                            </span>
                                            <input type="checkbox" class="check" data-acudiente="<%= n %>"
                                                aria-label="Asistencia acudiente <%= n %> de <%= g.Estudiante %>"
                                                <%= estado ? 'checked' : '' %> />
                                        </label>
                                    <% }) %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <p class="empty-state" id="emptyState" hidden>No se encontraron estudiantes con ese criterio.</p>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-content">
            <span>&copy; <%= new Date().getFullYear() %> Control de Grados</span>
            <span>Desarrollado por Yeison</span>
        </div>
    </footer>

    <script type="module" src="/js/dashboard.js"></script>
</body>

</html>
