<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de asistencia | Control de Grados</title>
    <meta name="description" content="Registro de llegada de los acudientes a la ceremonia de grados." />
    <meta name="theme-color" content="#0f1b33" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/webp" href="/img/cursos-logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="/css/style.css" />
</head>

<body data-supabase-url="<%= supabaseUrl %>" data-supabase-key="<%= supabaseAnonKey %>" data-canal="<%= canal %>">
    <a href="#busqueda" class="skip-link">Ir a la búsqueda</a>

    <!-- BARRA SUPERIOR -->
    <header class="topbar">
        <a href="/dashboard" class="topbar-brand">
            <img src="/img/cursos-logo.jpg" alt="" class="logo" />
            <span class="topbar-title">
                <strong>Control de Grados</strong>
                <span>Sistema de asistencia</span>
            </span>
        </a>

        <div class="topbar-user">
            <div class="user-chip">
                <span class="user-avatar" aria-hidden="true"><%= (user.nombre || "?").charAt(0) %></span>
                <span class="user-name"><%= user.nombre %></span>
            </div>
            <a href="/logout" class="btn btn-ghost-light">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Salir</span>
            </a>
        </div>
    </header>

    <main class="dashboard">
        <!-- ENCABEZADO -->
        <div class="page-header" data-enter>
            <div class="page-header-text">
                <h1>Asistencia de acudientes</h1>
                <p>Hola, <%= (user.nombre || "").split(" ")[0] %>. Toca la tarjeta de cada acudiente cuando llegue.</p>
            </div>
            <span class="live-indicator" id="liveIndicator" role="status">
                <span class="live-dot"></span>
                <span id="liveText">Conectando…</span>
            </span>

            <!-- Progreso de llegada de la ceremonia activa -->
            <div class="progress-card">
                <p class="progress-text">
                    <strong id="progresoLlegados">0</strong> de <span id="progresoTotal">0</span> acudientes han llegado
                    <span class="progress-scope" id="progresoCeremonia"></span>
                </p>
                <span class="progress-percent" id="progresoPorcentaje">0%</span>
                <div class="progress-bar" role="progressbar" aria-labelledby="progresoLlegados" aria-valuemin="0"
                    aria-valuemax="100" aria-valuenow="0" id="progresoBarra">
                    <span class="progress-fill" id="progresoRelleno"></span>
                </div>
            </div>
        </div>

        <!-- Barra fija al hacer scroll: ceremonias + búsqueda -->
        <div class="sticky-tools">
        <!-- CEREMONIAS (se generan a partir de los datos) -->
        <section class="ceremonia-panel" aria-labelledby="ceremoniaLabel">
            <span class="ceremonia-panel-label" id="ceremoniaLabel">Ceremonia en curso</span>
            <div class="ceremonia-tabs" role="tablist" aria-labelledby="ceremoniaLabel">
                <% ceremonias.forEach(c => { %>
                    <button type="button" class="ceremonia-tab" role="tab" aria-selected="false" data-ceremonia="<%= c %>">
                        <span class="ceremonia-tab-label"><%= c %></span>
                        <span class="ceremonia-tab-count">0</span>
                    </button>
                <% }) %>
                <% if (haySinCeremonia) { %>
                    <button type="button" class="ceremonia-tab" role="tab" aria-selected="false" data-ceremonia="">
                        <span class="ceremonia-tab-label">Sin ceremonia</span>
                        <span class="ceremonia-tab-count">0</span>
                    </button>
                <% } %>
                <button type="button" class="ceremonia-tab" role="tab" aria-selected="false" data-ceremonia="*">
                    <span class="ceremonia-tab-label">Todas</span>
                    <span class="ceremonia-tab-count">0</span>
                </button>
            </div>
        </section>

        <!-- HERRAMIENTAS -->
        <div class="toolbar">
            <div class="search-wrapper">
                <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <label for="busqueda" class="sr-only">Buscar estudiante</label>
                <input type="search" id="busqueda" placeholder="Buscar por nombre o código"
                    autocomplete="off" aria-keyshortcuts="/" />
                <kbd class="search-kbd" aria-hidden="true">/</kbd>
                <button type="button" class="btn-clear" id="btnClear" aria-label="Limpiar búsqueda" hidden>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <button type="button" class="btn btn-toggle-stats" id="btnToggleStats" aria-expanded="false"
                aria-controls="statsContainer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="20" x2="12" y2="10"></line>
                    <line x1="18" y1="20" x2="18" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="16"></line>
                </svg>
                <span>Ver estadísticas</span>
                <svg class="icon-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>
        </div>
        </div>

        <!-- ESTADÍSTICAS (ocultas por defecto) -->
        <section class="stats-grid" id="statsContainer" aria-label="Estadísticas de asistencia" hidden>
            <button type="button" class="stat-card stat-success" data-filter="ambos">
                <span class="stat-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </span>
                <span>
                    <span class="stat-value" id="countAmbos">0</span>
                    <span class="stat-label">Ambos llegaron</span>
                </span>
            </button>

            <button type="button" class="stat-card stat-partial" data-filter="uno">
                <span class="stat-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </span>
                <span>
                    <span class="stat-value" id="countUno">0</span>
                    <span class="stat-label">Solo uno llegó</span>
                </span>
            </button>

            <button type="button" class="stat-card stat-pending" data-filter="ninguno">
                <span class="stat-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </span>
                <span>
                    <span class="stat-value" id="countNinguno">0</span>
                    <span class="stat-label">Ninguno ha llegado</span>
                </span>
            </button>

            <button type="button" class="stat-card stat-total" data-filter="todos">
                <span class="stat-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </span>
                <span>
                    <span class="stat-value" id="countTotal">0</span>
                    <span class="stat-label">Estudiantes</span>
                </span>
            </button>
        </section>

        <!-- TABLA -->
        <section class="table-card">
            <div class="table-card-header">
                <span id="resultCount"><%= grados.length %> estudiantes</span>
                <div class="legend" aria-hidden="true">
                    <span class="legend-item"><span class="legend-swatch ambos"></span>Ambos</span>
                    <span class="legend-item"><span class="legend-swatch uno"></span>Uno</span>
                    <span class="legend-item"><span class="legend-swatch ninguno"></span>Ninguno</span>
                    <span class="legend-item"><span class="legend-swatch novedad"></span>Con novedad</span>
                </div>
            </div>

            <table id="tablaGrados">
                <thead>
                    <tr>
                        <th scope="col">Estudiante</th>
                        <th scope="col">Acudientes y asistencia</th>
                    </tr>
                </thead>
                <tbody>
                    <% grados.forEach(g => { %>
                        <tr data-id="<%= g.id %>" data-ceremonia="<%= g.Ceremonia %>"
                            data-search="<%= [g.Estudiante, g.Codigo, g.Acudiente_1, g.Acudiente_2].filter(v => v != null).join(' ') %>"
                            class="<%= (g.estado1 && g.estado2) ? 'fila-ambos-asistieron' : (g.estado1 || g.estado2) ? 'fila-uno-asistio' : 'fila-ninguno-asistio' %>">
                            <td>
                                <span class="student-name-row">
                                    <span class="student-name"><%= g.Estudiante %></span>
                                    <% if (g.Novedad) { %>
                                        <span class="novedad-indicador" title="Este estudiante tiene una novedad">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                            </svg>
                                            Novedad
                                        </span>
                                    <% } %>
                                </span>
                                <span class="student-meta">
                                    <span class="student-code">Código <%= g.Codigo %></span>
                                    <span class="ceremonia-badge <%= g.Ceremonia ? '' : 'sin-ceremonia' %>"><%= g.Ceremonia || 'Sin ceremonia' %></span>
                                </span>

                                <span class="aviso-otra-ceremonia" hidden>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                        <line x1="12" y1="9" x2="12" y2="13"></line>
                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                    </svg>
                                    <span>No es de esta ceremonia: pertenece a <strong><%= g.Ceremonia || 'Sin ceremonia' %></strong></span>
                                </span>

                                <% if (g.Novedad) { %>
                                    <div class="novedad novedad-activa">
                                        <span class="novedad-titulo">Novedad</span>
                                        <span class="novedad-texto"><%= g.Novedad %></span>
                                    </div>
                                <% } else { %>
                                    <p class="novedad novedad-vacia">Sin novedad</p>
                                <% } %>
                            </td>
                            <td>
                                <div class="acudientes-container">
                                    <% [1, 2].forEach(n => { const estado = g['estado' + n]; %>
                                        <label class="acudiente-item <%= estado ? 'asistio' : 'no-asistio' %>" data-name="<%= n %>">
                                            <input type="checkbox" class="check" data-acudiente="<%= n %>"
                                                aria-label="Asistencia acudiente <%= n %> de <%= g.Estudiante %>"
                                                <%= estado ? 'checked' : '' %> />
                                            <span class="acudiente-info">
                                                <span class="acudiente-label">Acudiente <%= n %></span>
                                                <span class="acudiente-name"><%= g['Acudiente_' + n] %></span>
                                            </span>
                                            <span class="acudiente-estado">
                                                <svg class="icono-asistio" width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                <svg class="icono-no-asistio" width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                                <span class="texto-asistio">Llegó</span>
                                                <span class="texto-no-asistio">No ha llegado</span>
                                            </span>
                                        </label>
                                    <% }) %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    <tr class="separador-ceremonias" id="separadorCeremonias" hidden>
                        <td colspan="2" id="separadorTexto">Encontrados en otras ceremonias</td>
                    </tr>
                </tbody>
            </table>

            <div class="empty-state" id="emptyState" hidden>
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <p>Ningún estudiante coincide con esa búsqueda o filtro.</p>
            </div>
        </section>
    </main>

    <!-- Confirmación para desmarcar una llegada -->
    <dialog class="confirm-dialog" id="confirmDialog" aria-labelledby="confirmTitulo" aria-describedby="confirmTexto">
        <form method="dialog">
            <h2 id="confirmTitulo">¿Quitar la llegada?</h2>
            <p id="confirmTexto"></p>
            <div class="confirm-actions">
                <button type="submit" value="cancelar" class="btn btn-secondary" autofocus>Dejar como llegó</button>
                <button type="submit" value="confirmar" class="btn btn-danger">Quitar llegada</button>
            </div>
        </form>
    </dialog>

    <!-- Avisos breves (errores al guardar) -->
    <div class="toast-region" id="toastRegion" role="status" aria-live="polite"></div>

    <footer class="footer">
        <div class="footer-content">
            <span>&copy; <%= new Date().getFullYear() %> Control de Grados</span>
            <span>Desarrollado por Yeison</span>
        </div>
    </footer>

    <script type="module" src="/js/dashboard.js"></script>
</body>

</html>
